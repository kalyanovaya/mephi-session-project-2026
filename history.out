  235  shopt -s lithist
  236  set -e
  237  {
export LC_ALL=C.UTF-8
/root/check-reboot.sh
cat /root/mephi-results/reboot-check.out
/root/collect.sh
history -w
history > /root/mephi-results/history.out
}
  238  {
cd /root/mephi-results
dnf history info 3 > update-details.out
cat update-details.out | tail -25
getcap /usr/sbin/tcpdump > getcap.out
readlink -f /sbin/tcpdump
history -w
history > history.out
}
  239  {
cd /root/mephi-results
head -16 update-details.out
restorecon -nv /etc/passwd /mephi-web /mephi-web/index.html > selinux-cache-check.out 2>&1
matchpathcon -V /mephi-web /mephi-web/index.html >> selinux-cache-check.out 2>&1
cat selinux-cache-check.out
history -w
history > history.out
}
  240  {
TERM=xterm clear > /dev/ttyAMA0
bash -x -c 'grep "^PRETTY_NAME=" /etc/os-release; hostname; getenforce; curl -sS http://localhost' > /dev/ttyAMA0 2>&1
history -w
history > /root/mephi-results/history.out
}
